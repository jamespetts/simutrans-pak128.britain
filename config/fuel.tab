# Fuel costs over time
# Per unit as defined below. One for each traction type.
# Note: all fuel units are divided by 1,000 when specified per km for vehicles: see
# the fuel_unit_cost_divider specification in simuconf.tab

# Battery and fuel-cell traction normally have no entry of their own: their energy is
# bought as electricity (the fuel[electric] entries below), and their running cost is
# the electricity price divided by a round-trip efficiency, because a proportion of the
# electricity is lost in the round trip (battery: charging/discharging; fuel cell:
# electrolysis to hydrogen and back). The efficiency is, in order of precedence:
#   1. the per-vehicle value in the vehicle .dat file (battery_round_trip_efficiency /
#      fuel_cell_round_trip_efficiency; 0 = not set); otherwise
#   2. the global value in simuconf.tab (battery_round_trip_efficiency /
#      fuel_cell_round_trip_efficiency); otherwise
#   3. a hard-coded default (battery 85%, fuel cell 40%).
# If a fuel[...] entry should be supplied here for battery or fuel cell, it is used directly
# instead of the electricity derivation.

# Last updated: 2026-11-15. All series now run to 2050. Petrol, diesel, jet and
# electricity carry 2026 values; coal ends in 2026 and is carried on the general
# index, as no steam vehicle runs that late. 2050 points are all projected at
# constant real prices, i.e. grown with the general index from prices.tab.
# Sources: DESNZ road fuel prices (petrol, diesel); DESNZ QEP 3.4.1 non-domestic
# electricity (electric); IATA/Platts jet fuel via EUROCONTROL (turbine).
# The electric series was rebased from 2017 on the coal-consistent conversion; see
# the note on that line.

# Based on English coal prices. Welsh coal was more expensive.
# Adjust the consumption rate for locomotives that used Welsh coal to normalise for energy content.
# Units: kg 
fuel[steam]=1750,5,1760,6,1790,6,1800,9,1810,10,1830,10,1840,8,1850,10,1860,11,1880,6,1882,6,1885,5,1890,9,1895,6,1897,5,1900,10,1905,7,1910,8,1913,10,1914,13,1919,29,1924,22,1925,17,1928,16,1929,16,1933,17,1947,40,1948,46,1949,47,1950,47,1955,82,1959,91,1968,55,1971,115,1973,149,1974,265,1976,381,1980,718,2017,1486,2018,1751,2019,1704,2020,1495,2026,1944,2050,3251

