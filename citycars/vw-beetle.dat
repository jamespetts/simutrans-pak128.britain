# Volkswagen Beetle (Type 1), 1950s-1970s form.
#
# The rear-engined Beetle, built 1938-2003; the modelled form is the 1960s car
# common on British roads. 4,079 mm long, 1,540 mm wide, 1,500 mm high,
# 2,400 mm wheelbase.
# https://en.wikipedia.org/wiki/Volkswagen_Beetle
#
# Colours: black, blue, red and white were common Beetle finishes through the
# 1960s.
#
# Weight: 240 in total (black 90, blue 60, red 50, white 40), reflecting the large
# 1960s-70s UK parc.
#
# Speed 110 km/h; comfort 45/250 (line). Classes 0,1,2.
# Dates: 1950 with a road tail to about 1985.
#
# Metres master: citycars/4.5/vw-beetle.blend. References:
# citycars/references/vw-beetle/ (gitignored). Images via Wikimedia Commons.

obj=citycar
name=VWBeetle(Black)
copyright=JamesPetts

DistributionWeight=90
intro_year=1950
intro_month=1
retire_year=1985
retire_month=6
speed=110
class=0,1,2
maximum_comfortable_journey_minutes=45
maximum_tolerable_journey_minutes=250

Image[E]=./images/vw-beetle-black_E.0.0,-33,14
Image[SE]=./images/vw-beetle-black_SE.0.0,-13,0
Image[S]=./images/vw-beetle-black_S.0.0,0,0
Image[SW]=./images/vw-beetle-black_SW.0.0,-8,10
Image[W]=./images/vw-beetle-black_W.0.0,4,5
Image[NW]=./images/vw-beetle-black_NW.0.0,12,10
Image[N]=./images/vw-beetle-black_N.0.0,0,33
