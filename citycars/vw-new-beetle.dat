# Volkswagen New Beetle, 1998-2011.
#
# The retro-styled New Beetle: 4,128 mm long, 1,724 mm wide, 1,498 mm high,
# 2,515 mm wheelbase.
# https://en.wikipedia.org/wiki/Volkswagen_Beetle#New_Beetle_(1997%E2%80%932010)
#
# Colours: black, blue, red and white are period New Beetle finishes.
#
# Weight: 150 in total (black 50, blue 40, red 35, white 25).
#
# Speed 180 km/h; comfort 100/480 (line). Classes 1,2.
# Dates: 1998-2011 with a road tail to about 2015.
#
# Metres master: citycars/4.5/vw-new-beetle.blend. References:
# citycars/references/vw-new-beetle/ (gitignored). Images via Wikimedia Commons.

obj=citycar
name=VWNewBeetle(Black)
copyright=JamesPetts

DistributionWeight=50
intro_year=1998
intro_month=6
retire_year=2015
retire_month=6
speed=180
class=1,2
maximum_comfortable_journey_minutes=100
maximum_tolerable_journey_minutes=480

