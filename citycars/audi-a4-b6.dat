# https://en.wikipedia.org/wiki/Audi_A4
# Audi A4 B6 (Typ 8E) saloon, UK market, November 2000 - 2005 (replaced by the B7 in November 2004)
# Intro/retire dates staggered per colour: these reflect when the colour would be seen regularly
# on UK roads, not the model's production dates (which ended November 2004).
# Distribution weights scaled from DVSA UK first-registration colour shares for 2000-2005
# registrations (see New/ai/objects/citycar.md for the sources), and set in the Focus-Ka tier.

obj=citycar
name=AudiA4B6(Silver)
copyright=JamesPetts

DistributionWeight=16
intro_year=2000
intro_month=11
retire_year=2027
retire_month=12
speed=135
class=2,3
maximum_comfortable_journey_minutes=150
maximum_tolerable_journey_minutes=405

