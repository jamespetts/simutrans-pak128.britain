# Rover P4 90 four-door saloon, 1954-1959.
#
# The 2.6-litre six P4 introduced for the 1954 model year: the same body as
# the 75 and 60 with a larger engine and a higher trim level.
# https://en.wikipedia.org/wiki/Rover_P4
#
# Dimensions: variant-specific overall figures were not established; the
# family wheelbase is 2.819 m. The model is built on that wheelbase and the
# photographed body.
#
# Shape reference: no true level side elevation exists. Image 1 is identified
# by the wing script and the Commons registration description; images 2 and 3
# are front and front three-quarter views. The flank is estimated; the
# limitation is recorded.
#
# Colours: grade (b), the P4 Drivers Guild's year-based compilation. Black,
# Sage Green, Dove Grey and Maroon. Weights 15, 13, 12, 10, total 50,
# provisional.
#
# Speed 145 km/h. Comfort 62/423, on the line 330 + 1.5 x 62. Classes 2,3.
# Dates are road presence: 1953 intro, retires staggered 1975-1978.
#
# Metres master: citycars/4.5/rover-p4-90.blend. Interchange:
# citycars/4.5/rover-p4-90.dae. References:
# citycars/references/rover-p4-90/ (gitignored; Wikimedia Commons).
#
# Accepted deviations: there is no true side or rear view; the rear is inherited
# from the P4 60 master, the fascia is too similar to the 60, and the wing script
# is represented by a chrome mark rather than readable lettering. At 128 px the
# P4 body and the 90's grille and lamps read as a P4 90.


obj=citycar
name=RoverP490(Black)
copyright=JamesPetts

DistributionWeight=15
intro_year=1953
intro_month=9
retire_year=1978
retire_month=6
speed=145
class=2,3
maximum_comfortable_journey_minutes=62
maximum_tolerable_journey_minutes=423

Image[E]=./images/rover-p4-90-black_E.0.0,-33,14
Image[SE]=./images/rover-p4-90-black_SE.0.0,-13,0
Image[S]=./images/rover-p4-90-black_S.0.0,0,0
Image[SW]=./images/rover-p4-90-black_SW.0.0,-8,10
Image[W]=./images/rover-p4-90-black_W.0.0,4,5
Image[NW]=./images/rover-p4-90-black_NW.0.0,12,10
Image[N]=./images/rover-p4-90-black_N.0.0,0,33
Image[NE]=./images/rover-p4-90-black_NE.0.0,0,24
