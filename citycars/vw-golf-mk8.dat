# Retire policy 2026-11-20: still in production in 2026 with no announced end; retire dates commented out. Revisit when an end is announced.
# Volkswagen Golf Mk8 five-door hatchback, 2020-present.
#
# 4,284 mm long, 1,789 mm wide, 1,456 mm high, 2,636 mm wheelbase; 1.0-2.0
# petrol and 2.0 diesel, plus the GTI, GTE and R. Facelift 2024.
# https://en.wikipedia.org/wiki/Volkswagen_Golf_Mk8
#
# Colours: Tornado Red, Reflex Silver, Deep Black and Pure White are period Golf
# colours.
#
# Weight: 280 in total (red 80, silver 80, black 65, white 55).
#
# Speed 220 km/h; comfort 130/525 (line). Classes 1,2.
# Dates: 2020 onwards; still in production in 2026, so the retire dates are commented out.
#
# Metres master: citycars/4.5/vw-golf-mk8.blend. References:
# citycars/references/vw-golf-mk8/ (gitignored). Images via Wikimedia Commons.

obj=citycar
name=VWGolfMk8(TornadoRed)
copyright=JamesPetts

DistributionWeight=80
intro_year=2020
intro_month=3
#retire_year=2036
#retire_month=6
speed=220
length=3
class=1,2
maximum_comfortable_journey_minutes=130
maximum_tolerable_journey_minutes=525

