# Retire policy 2026-11-20: production ended 2014, with the Mk5 stand-in to 2022; retire dates are road-presence estimates, staggered by colourway.
# https://en.wikipedia.org/wiki/Ford_Mondeo_(fourth_generation)
# This is also intended to cover the fifth generation. Retire dates 2030-2034 are a road-presence estimate for the Mk4 shape and the Mk5 stand-in.
obj=citycar
name=FordMondeoMk4(Blue)
copyright=JamesPetts

DistributionWeight=8
intro_year=2007
intro_month=4
retire_year=2030
retire_month=6
speed=155
class=0,1,2
maximum_comfortable_journey_minutes=135
maximum_tolerable_journey_minutes=533

