# Fiat Panda third generation five-door, 2012 onwards.
#
# The type 319 Panda: the squarer, more mature city car with the higher
# waistline, the revised grille and the five-door body. UK sales from the end
# of February 2012. The 4x4 and Cross are taller, wider variants and are not
# separately represented.
# https://en.wikipedia.org/wiki/Fiat_Panda
#
# Dimensions 3.653 x 1.643 x 1.551 m, wheelbase 2.300 m (front-drive car).
#
# Shape reference: the pack's images show a red UK car in side, front and
# rear views; the side view governs.
#
# Colours: grade (d); the UK release names ten colours but not their names.
# White, red, blue and grey are plain names. Weights 12, 10, 10, 8, total 40,
# provisional.
#
# Speed 160 km/h. Comfort 65/280, on the line 180 + 1.5 x 65. Classes 0,1.
# Dates are road presence: 2012 intro, retires staggered 2032-2035.
#
# Metres master: citycars/4.5/fiat-panda-3.blend. Interchange:
# citycars/4.5/fiat-panda-3.dae. References:
# citycars/references/fiat-panda-3/ (gitignored; Wikimedia Commons).
#
# Accepted deviations: the lamp surrounds and wheel-arch contours are
# simplified. At 128 px the squarer body, higher waistline and revised grille
# read as a type 319 Panda.


obj=citycar
name=FiatPanda3(White)
copyright=JamesPetts

DistributionWeight=12
intro_year=2012
intro_month=2
retire_year=2035
retire_month=6
speed=160
class=0,1
maximum_comfortable_journey_minutes=65
maximum_tolerable_journey_minutes=280

Image[E]=./images/fiat-panda-3-white_E.0.0,-33,14
