# https://en.wikipedia.org/wiki/Morris_Oxford_Series_III
# Oxford Series III, October 1956 - July 1959. The weights in this 2017 file
# predate the 2026 colour-share method (New/ai/objects/citycar.md).
# Blue: Island Blue (BU-9), the documented Morris blue of 1958-66, so this
# colourway enters in January 1958 rather than at the 1956 launch. A Series
# III-specific colour list was not found; source: Morris colour list,
# https://classiccarhub.co.uk/morris-classic-paint-colour-codes/
obj=citycar
name=MorrisOxford3(Grey)
copyright=JamesPetts

DistributionWeight=8
intro_year=1956
intro_month=10
retire_year=1959
retire_month=7
speed=120
length=3
class=2,3
maximum_comfortable_journey_minutes=60
maximum_tolerable_journey_minutes=420

Image[E]=./images/morris-oxford-3-grey_E.0.0,-33,14
Image[SE]=./images/morris-oxford-3-grey_SE.0.0,-13,0
Image[S]=./images/morris-oxford-3-grey_S.0.0,0,0
Image[SW]=./images/morris-oxford-3-grey_SW.0.0,-8,10
Image[W]=./images/morris-oxford-3-grey_W.0.0,4,5
Image[NW]=./images/morris-oxford-3-grey_NW.0.0,12,10
Image[N]=./images/morris-oxford-3-grey_N.0.0,0,33
Image[NE]=./images/morris-oxford-3-grey_NE.0.0,0,24
