# Rover P6 four-door saloon, 1963-1977.
#
# The P6 "2000": 4,572 mm long, 1,683 mm wide, 1,397 mm high, 2,667 mm wheelbase;
# 2.0 four then 3.5 V8 from 1968, four-cylinder cars with a de Dion rear end.
# Car of the Year 1964, and the strongest-evidenced 1960s class-3 model in the
# research return. https://en.wikipedia.org/wiki/Rover_P6
#
# Colours: Arden Green, Davos White, Squadron Blue and Mexico Brown are documented
# Rover finishes of the period.
#
# Weight: 120 in total (green 35, white 35, blue 30, brown 20) — a volume executive
# car of the late 1960s and 1970s, so above the 1950s prestige weights.
#
# Speed 180 km/h; comfort 110/345 (line). Classes 2,3.
# Dates: 1963-1977 with a road tail to about 1988.
#
# Metres master: citycars/4.5/rover-p6.blend. References:
# citycars/references/rover-p6/ (gitignored). Images via Wikimedia Commons.

obj=citycar
name=RoverP6(ArdenGreen)
copyright=JamesPetts

DistributionWeight=35
intro_year=1963
intro_month=10
retire_year=1988
retire_month=6
speed=180
class=2,3
maximum_comfortable_journey_minutes=110
maximum_tolerable_journey_minutes=345

Image[E]=./images/rover-p6-green_E.0.0,-33,14
Image[SE]=./images/rover-p6-green_SE.0.0,-13,0
