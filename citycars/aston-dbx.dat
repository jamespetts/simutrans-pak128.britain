# Retire policy 2026-11-20: still in production in 2026 with no announced end; retire dates commented out. Revisit when an end is announced.
# Aston Martin DBX SUV, 2020 onwards.
#
# Aston's first SUV, built at St Athan, Wales: the tall five-door body with
# the long bonnet, the DB grille, the pronounced rear haunches and the
# full-width rear light bar. The DBX707 of 2022 is a power and trim variant
# on the same shell and is not separately represented.
# https://en.wikipedia.org/wiki/Aston_Martin_DBX
#
# Dimensions 5.039 x 1.998 x 1.680 m, wheelbase 3.060 m.
#
# Shape reference: a champagne-gold DBX on a Seoul street in true side
# elevation, and a Midnight Blue US car in front and rear three-quarter.
# The side view is one car; the three-quarters another of the same model.
#
# Colours: grade (c), documented period cars. Silver, black, blue and British
# Racing Green are the plain names used. Weights 3, 3, 2, 2, total 10,
# provisional.
#
# Speed 291 km/h. Comfort 92/468, on the line 330 + 1.5 x 92: the tallest
# and most spacious Aston. Classes 3,4.
# Dates are road presence: 2020 intro, retire dates commented out (still in production in 2026).
#
# Metres master: citycars/4.5/aston-dbx.blend. Interchange:
# citycars/4.5/aston-dbx.dae. References:
# citycars/references/aston-dbx/ (gitignored; Wikimedia Commons).
#
# Accepted deviations: the rear corners are too square and the tail-light
# blade is uneven. At 128 px the tall SUV proportions, DB grille and roof
# spoiler read as a DBX.


obj=citycar
name=AstonDBX(Silver)
copyright=JamesPetts

DistributionWeight=3
intro_year=2020
intro_month=7
#retire_year=2049
#retire_month=6
speed=291
class=3,4
maximum_comfortable_journey_minutes=92
maximum_tolerable_journey_minutes=468

Image[E]=./images/aston-dbx-silver_E.0.0,-33,14
