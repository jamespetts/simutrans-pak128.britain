Image[S]=./images/bmw-g20-white_S.0.0,0,0
Image[SW]=./images/bmw-g20-white_SW.0.0,-8,10
Image[W]=./images/bmw-g20-white_W.0.0,4,5
Image[NW]=./images/bmw-g20-white_NW.0.0,12,10
