# Stop waiting comfort values added 2026-11-27.
# Sources: Board of Trade Requirements 1892/1902; Hansard 1889-90, 1940;
# Quick, Railway Passenger Stations (RCHS 2023); NR/GN/CIV/100/03 (2023);
# NR/GN/CIV/200/03 (2022); DfT disruption handling (2021); CAA CAP 1258 (2015).
# Method and full table: New/ai/comfort/stop-waiting.md.

Obj=building
Name=StagingInn
# must be 1*1
type=stop
waytype=road
intro_year=1700
intro_month=1
retire_year=1844
retire_month=4
noconstruction=1
enables_pax=1
enables_post=1
#NoInfo=1
Dims=1,1,4
level=3
allow_underground=0
capacity=40
# Stop waiting comfort (see New/ai/comfort/stop-waiting.md)
maximum_comfortable_wait_minutes=75
maximum_tolerable_wait_minutes=1440
comfort_capacity=30
cost=70000
maintenance=450

layover_enable=1
replenish_enable=1

BackImage[3][0][0][0][0][0]=staging-inn-back.0.3
FrontImage[3][0][0][0][0][0]=staging-inn-front.0.3
BackImage[2][0][0][0][0][0]=staging-inn-back.0.0
FrontImage[2][0][0][0][0][0]=staging-inn-front.0.0
BackImage[1][0][0][0][0][0]=staging-inn-back.0.1
FrontImage[1][0][0][0][0][0]=staging-inn-front.0.1
BackImage[0][0][0][0][0][0]=staging-inn-back.0.2
FrontImage[0][0][0][0][0][0]=staging-inn-front.0.2
BackImage[3][0][0][0][0][1]=staging-inn-back-snow.0.3
FrontImage[3][0][0][0][0][1]=staging-inn-front-snow.0.3
BackImage[2][0][0][0][0][1]=staging-inn-back-snow.0.0
FrontImage[2][0][0][0][0][1]=staging-inn-front-snow.0.0
BackImage[1][0][0][0][0][1]=staging-inn-back-snow.0.1
FrontImage[1][0][0][0][0][1]=staging-inn-front-snow.0.1
BackImage[0][0][0][0][0][1]=staging-inn-back-snow.0.2
FrontImage[0][0][0][0][0][1]=staging-inn-front-snow.0.2
icon=> staging-inn-icon.0.1
cursor=staging-inn-icon.0.0
---

Obj=building
Name=LargeInn
type=extension
intro_year=1700
intro_month=1
retire_year=1844
retire_month=4
noconstruction=1
enables_pax=1
enables_post=0
#NoInfo=1
Dims=1,1,1
level=3
allow_underground=0
capacity=120
# Stop waiting comfort (see New/ai/comfort/stop-waiting.md)
maximum_comfortable_wait_minutes=90
maximum_tolerable_wait_minutes=2160
comfort_capacity=80
cost=480000
maintenance=3200

layover_enable=1
replenish_enable=1

FrontImage[0][0][0][0][0][0]=staging-inn-front.1.0
FrontImage[0][0][0][0][0][1]=staging-inn-front-snow.1.0
icon=> large-inn-icon.0.1
cursor=large-inn-icon.0.0
--
