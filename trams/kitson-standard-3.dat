# See Gladwin pp. 109-202 of vol. 3 and pp. 64-5 of vol. 1 for data.
obj=vehicle
waytype=tram_track
name=kitson-standard-3
engine_type=steam
# These had effective condensers
#smoke=Steam
speed=16
power=31
# Maximum output: the Kitson no. 3's documented 42 hp duty rating, scaled by engine weight.
# The steam sheet's power column holds the service average, not this maximum; see New/ai/fuel/steam-tram.md.
# Fuel: 3100 g of coke per km in street service, 5.6 kg/h per sq ft of grate at 16 km/h.
# Kinnear Clark, Tramways (1894), company coal accounts; see New/ai/fuel/steam-tram.md.
fuel_per_km=3100
calibration_speed=16
# Coal space: rear bunker, about 0.97 cubic metres for a three-unit body, 470 kg/m3 of lump coke.
# Capacity 410 kg gives a coal range of 132 km at 3100 g/km. See New/ai/fuel/steam-tram.md.
range=132
tractive_effort=18
copyright=jamespetts
intro_year=1886
intro_month=5
retire_year=1908
retire_month=4
length=3

weight=11
axles=2
cost=295000
runningcost=5
fixed_cost=16246
sound=laurie-barclay-0-4-0.wav

can_lead_from_rear=0
bidirectional=1
way_constraint_prohibitive[0]=0

Constraint[Prev][0]=none



EmptyImage[E]=./images/kitson-standard-3_E.0.0
EmptyImage[SE]=./images/kitson-standard-3_SE.0.0
EmptyImage[S]=./images/kitson-standard-3_S.0.0
EmptyImage[SW]=./images/kitson-standard-3_SW.0.0
EmptyImage[W]=./images/kitson-standard-3_W.0.0
EmptyImage[NW]=./images/kitson-standard-3_NW.0.0
EmptyImage[N]=./images/kitson-standard-3_N.0.0
EmptyImage[NE]=./images/kitson-standard-3_NE.0.0
