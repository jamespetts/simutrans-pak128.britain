# Fuel: 3100 g of coke per km in street service, 5.6 kg/h per sq ft of grate at 16 km/h.
# Kinnear Clark, Tramways (1894), company coal accounts; see New/ai/fuel/steam-tram.md.
fuel_per_km=3100
calibration_speed=16
tractive_effort=18
