# See Gladwin (vol. 1) pp. 66-67 for illustrations
# and pp. 109-202 of vol. 3 and pp. 64-5 of vol. 1 for data.
obj=vehicle
waytype=tram_track
name=kitson-standard-2
engine_type=steam
# These had effective condensers
#smoke=Steam
speed=16
power=27
# Maximum output: the Kitson no. 3's documented 42 hp duty rating, scaled by engine weight.
# The steam sheet's power column holds the service average, not this maximum; see New/ai/fuel/steam-tram.md.
# Fuel: 2800 g of coke per km in street service, 7.5 kg/h per sq ft of grate at 16 km/h.
# Kinnear Clark, Tramways (1894), company coal accounts; see New/ai/fuel/steam-tram.md.
fuel_per_km=2800
calibration_speed=16
tractive_effort=16
copyright=jamespetts
intro_year=1882
intro_month=11
retire_year=1891
retire_month=3
length=3

weight=9.5
axles=2
cost=210000
runningcost=4
fixed_cost=16175
sound=laurie-barclay-0-4-0.wav

can_lead_from_rear=0
bidirectional=1
way_constraint_prohibitive[0]=0

Constraint[Prev][0]=none



EmptyImage[E]=./images/kitson-standard-2_E.0.0
EmptyImage[SE]=./images/kitson-standard-2_SE.0.0
